---
const { brand, links = [] } = Astro.props;
---
<header class="sbl-shell">
  <nav class="sbl-nav" aria-label="Hauptnavigation">
    <a class="sbl-brand" href="/">{brand}</a>
    <ul class="sbl-nav-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
