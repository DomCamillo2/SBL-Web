---
import BaseLayout from "../components/BaseLayout.astro";
import SectionPhases from "../components/SectionPhases.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Breadcrumbs from "@sbl-web/ui/components/Breadcrumbs.astro";
import "../styles/archetype.css";
import { getPage } from "../lib/content.js";
import { createPageShell, pageTitle } from "../lib/pageShell.js";

const { content, layout } = createPageShell({
  path: "/vorgehen",
  navLinks: [
    { href: "/", label: "Start" },
    { href: "/kontakt", label: "Kontakt" },
  ],
});
const page = getPage(content, "method");
const section = page.sections?.[0];
const closing = page.sections?.find((s) => s.id === "closing_cta");
---

<BaseLayout title={pageTitle(content, page)} description={page.meta_description} {...layout}>
  <section class="sbl-section">
    <div class="sbl-shell sbl-legal">
      <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Vorgehen" }]} />
      <p class="sbl-kicker">Vorgehen</p>
      <h1>{page.title}</h1>
      <p class="sbl-lead">{page.meta_description}</p>
    </div>
  </section>
  {section && <SectionPhases section={section} />}
  {closing && <ClosingCta section={closing} />}
</BaseLayout>
