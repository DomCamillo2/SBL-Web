---
import BaseLayout from "../components/BaseLayout.astro";
import Breadcrumbs from "@sbl-web/ui/components/Breadcrumbs.astro";
import "../styles/archetype.css";
import { createPageShell } from "../lib/pageShell.js";

const { content, brief, brand, layout } = createPageShell({
  path: "/datenschutz",
  includeSchema: false,
  navLinks: [{ href: "/", label: "Start" }],
});

const analytics = brief?.launch?.analytics ?? {};
const formEndpoint = brief?.hosting?.form_endpoint;
---

<BaseLayout
  title={`Datenschutz${content.seo_defaults.title_suffix}`}
  description="Datenschutz"
  {...layout}
>
  <section class="sbl-section">
    <div class="sbl-shell sbl-legal">
      <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Datenschutz" }]} />
      <h1>Datenschutz</h1>
      <p>
        Verantwortliche Stelle: {brief?.business?.legal_name ?? brand}, {brief?.contact?.address}.
        Kontakt: {brief?.contact?.email}.
      </p>
      <h2>Hosting &amp; Logdaten</h2>
      <p>
        Beim Aufruf der Website werden technisch notwendige Verbindungsdaten (z. B. IP-Adresse,
        Zeitpunkt, aufgerufene Ressource) in Server-Logs verarbeitet, soweit für Betrieb und
        Sicherheit erforderlich (Art. 6 Abs. 1 lit. f DSGVO).
      </p>
      <h2>Kontaktformular</h2>
      <p>
        Angaben aus dem Kontaktformular werden zur Bearbeitung Ihrer Anfrage verarbeitet
        (Art. 6 Abs. 1 lit. b bzw. lit. f DSGVO).
        {formEndpoint
          ? ` Die Übermittlung erfolgt an den konfigurierten Formular-Endpunkt.`
          : ` In der Demo-Konfiguration erfolgt nur eine Weiterleitung auf eine Bestätigungsseite — Produktionsbetrieb erfordert einen datenschutzkonformen Endpoint.`}
      </p>
      <h2>Schriften</h2>
      <p>
        Schriftarten werden selbst gehostet (kein Abruf bei Google Fonts). Es findet kein
        Transfer an Google zum Zwecke des Font-Ladings statt.
      </p>
      <h2>Analyse</h2>
      {analytics.enabled ? (
        <p>
          Analyse-Dienst: {analytics.provider}
          {analytics.consent_required !== false
            ? " — Einsatz nur nach Einwilligung (TDDDG § 25 / DSGVO)."
            : "."}
        </p>
      ) : (
        <p>Es wird kein Analyse-Tracking eingesetzt.</p>
      )}
      <h2>Karten</h2>
      <p>
        Sofern verlinkt, öffnen Kartenangebote (z. B. Google Maps) erst nach Klick in einem
        neuen Kontext beim jeweiligen Anbieter.
      </p>
      <p class="sbl-meta">
        Dies ist eine Factory-Vorlage. Vor Go-Live an reale Verarbeitungen anpassen und freigeben.
      </p>
    </div>
  </section>
</BaseLayout>
