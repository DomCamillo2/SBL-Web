{
  "brand": {
    "name": "SBL-Web",
    "short_name": "SBL",
    "tagline": "Website-Factory für KMU — strukturiert, nicht vibecoded.",
    "locale": "de-DE"
  },
  "color": {
    "ink": "#141816",
    "ink_soft": "#2A302C",
    "paper": "#F3F5F2",
    "paper_deep": "#E4E8E3",
    "accent": "#C45C26",
    "accent_hover": "#A34A1C",
    "line": "#C8CFC6",
    "success": "#2F6B4F",
    "danger": "#A33B2A",
    "forbidden_primary_hues": [200, 290]
  },
  "typography": {
    "display": {
      "family": "Fraunces",
      "fallback": "Georgia, 'Times New Roman', serif",
      "role": "Wordmark optional / Editorial headlines in brand docs only"
    },
    "sans": {
      "family": "IBM Plex Sans",
      "fallback": "'IBM Plex Sans', 'Segoe UI', sans-serif",
      "role": "UI, README body, factory tooling"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallback": "'IBM Plex Mono', ui-monospace, monospace",
      "role": "Code, CLI, schema paths"
    },
    "do_not_use": ["Inter", "Roboto", "Arial", "Poppins", "Open Sans", "Montserrat"]
  },
  "logo": {
    "mark": "logo/sbl-mark.svg",
    "mark_png": "logo/sbl-mark.png",
    "wordmark": "logo/sbl-wordmark.svg",
    "wordmark_png": "logo/sbl-wordmark.png",
    "lockup": "logo/sbl-lockup.svg",
    "favicon": "logo/favicon.svg",
    "clear_space": "0.25 × mark height on all sides",
    "min_size_px": { "mark": 24, "wordmark_width": 120 }
  },
  "voice": {
    "tone": ["klar", "handwerklich", "präzise", "lokal verankert"],
    "avoid": ["innovativ", "ganzheitlich", "Cutting-edge", "AI-powered Hype", "Synergie"]
  }
}
