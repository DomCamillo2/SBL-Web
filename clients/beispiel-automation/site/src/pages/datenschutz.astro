---
import BaseLayout from "@sbl-web/archetype-service-local-b2b/components/BaseLayout.astro";
import Breadcrumbs from "@sbl-web/ui/components/Breadcrumbs.astro";
import "@sbl-web/archetype-service-local-b2b/styles.css";
import {
  createPageShell,
} from "@sbl-web/archetype-service-local-b2b/lib/pageShell.js";

const { content, brief, brand, layout } = createPageShell({
  path: "/datenschutz",
  includeSchema: false,
  navLinks: [{ href: "/", label: "Start" }],
});
---

<BaseLayout
  title={`Datenschutz${content.seo_defaults.title_suffix}`}
  description="Datenschutz"
  {...layout}
>
  <section class="sbl-section">
    <div class="sbl-shell sbl-legal">
      <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Datenschutz" }]} />
      <h1>Datenschutz</h1>
      <p>
        Diese Demo-Website speichert keine Analyse-Cookies. Das Kontaktformular leitet auf eine
        Danke-Seite weiter; in Produktion wird ein datenschutzkonformer Formular-Endpoint eingesetzt.
      </p>
      <p>
        Analytics ist in dieser Demo deaktiviert (`launch.analytics.enabled: false`). Wenn Analytics
        aktiviert wird, nur mit Einwilligung und Eintrag in dieser Datenschutzerklärung.
      </p>
      <p>
        Verantwortliche Stelle: {brief?.business?.legal_name ?? brand}, {brief?.contact?.address}.
      </p>
    </div>
  </section>
</BaseLayout>
