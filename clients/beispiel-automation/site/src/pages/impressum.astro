---
import BaseLayout from "@sbl-web/archetype-service-local-b2b/components/BaseLayout.astro";
import Breadcrumbs from "@sbl-web/ui/components/Breadcrumbs.astro";
import "@sbl-web/archetype-service-local-b2b/styles.css";
import {
  createPageShell,
} from "@sbl-web/archetype-service-local-b2b/lib/pageShell.js";

const { content, brief, brand, layout } = createPageShell({
  path: "/impressum",
  includeSchema: false,
  navLinks: [{ href: "/", label: "Start" }],
});
---

<BaseLayout
  title={`Impressum${content.seo_defaults.title_suffix}`}
  description="Impressum"
  {...layout}
>
  <section class="sbl-section">
    <div class="sbl-shell sbl-legal">
      <Breadcrumbs items={[{ label: "Start", href: "/" }, { label: "Impressum" }]} />
      <h1>Impressum</h1>
      <p><strong>{brief?.business?.legal_name ?? brand}</strong></p>
      <p>{brief?.contact?.address}</p>
      <p>E-Mail: {brief?.contact?.email}<br />Telefon: {brief?.contact?.phone}</p>
      <p>Vertreten durch: {brief?.legal?.owner ?? "—"}</p>
      <p>
        Dies ist eine Demo-Seite der SBL-Web Factory. Angaben sind beispielhaft und nicht rechtsverbindlich.
      </p>
    </div>
  </section>
</BaseLayout>
