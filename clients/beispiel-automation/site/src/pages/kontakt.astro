---
import BaseLayout from "@sbl-web/archetype-service-local-b2b/components/BaseLayout.astro";
import Breadcrumbs from "@sbl-web/ui/components/Breadcrumbs.astro";
import "@sbl-web/archetype-service-local-b2b/styles.css";
import { getPage } from "@sbl-web/archetype-service-local-b2b/lib/content.js";
import {
  createPageShell,
  pageTitle,
} from "@sbl-web/archetype-service-local-b2b/lib/pageShell.js";

const { content, brief, layout } = createPageShell({
  path: "/kontakt",
  navLinks: [
    { href: "/", label: "Start" },
    { href: "/vorgehen", label: "Vorgehen" },
  ],
});
const page = getPage(content, "contact");
const cta = brief?.contact?.cta_label ?? "Anfrage senden";
---

<BaseLayout
  title={pageTitle(content, page)}
  description={page.meta_description}
  {...layout}
>
  <section class="sbl-section">
    <div class="sbl-shell">
      <Breadcrumbs
        items={[
          { label: "Start", href: "/" },
          { label: "Kontakt" },
        ]}
      />
      <p class="sbl-kicker">Kontakt</p>
      <h1>{page.sections?.[0]?.headline ?? page.title}</h1>
      <p class="sbl-lead">{page.sections?.[0]?.support ?? page.meta_description}</p>
      {brief?.contact?.response_time_promise && (
        <p class="sbl-meta">{brief.contact.response_time_promise}</p>
      )}
      <form class="sbl-form" method="get" action="/danke">
        <label>
          Name
          <input name="name" type="text" required autocomplete="name" />
        </label>
        <label>
          E-Mail
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label>
          Welcher Prozess kostet regelmäßig Zeit?
          <textarea name="process" rows="5" required></textarea>
        </label>
        <button class="sbl-btn" type="submit">{cta}</button>
      </form>
      <p class="sbl-meta" style="margin-top:1.5rem">
        <span>{brief?.contact?.email}</span>
        <span>{brief?.contact?.phone}</span>
        <span>{brief?.contact?.address}</span>
      </p>
      {brief?.contact?.maps_url && (
        <p>
          <a class="sbl-link-underline" href={brief.contact.maps_url} rel="noopener noreferrer">
            Karte & Anfahrt öffnen
          </a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>
