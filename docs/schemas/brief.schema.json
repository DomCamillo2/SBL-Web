{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbl-web.local/schemas/brief.schema.json",
  "title": "KMU Website Brief",
  "type": "object",
  "required": [
    "slug",
    "business",
    "goal",
    "audience",
    "usp",
    "archetype",
    "pages",
    "contact",
    "legal"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL-safe client id, e.g. baeckerei-mueller"
    },
    "business": {
      "type": "object",
      "required": ["name", "industry", "city", "region"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "legal_name": { "type": "string" },
        "industry": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "founded_year": { "type": "integer", "minimum": 1800 },
        "employees": { "type": "string" },
        "tagline": { "type": "string", "maxLength": 120 }
      }
    },
    "goal": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "string",
          "enum": ["lead_form", "phone_call", "booking", "visit", "purchase"]
        },
        "secondary": { "type": "string" },
        "success_metric": { "type": "string" }
      }
    },
    "audience": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "objections": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 5
        }
      }
    },
    "usp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280,
      "description": "One human-written sentence. AI may shorten, not invent."
    },
    "archetype": {
      "type": "string",
      "enum": [
        "service-local-b2b",
        "handwerk-local",
        "gastro-local",
        "praxis-local",
        "retail-local",
        "custom"
      ]
    },
    "positioning": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 4
        },
        "do_not_sound_like": {
          "type": "array",
          "items": { "type": "string" }
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "notes": { "type": "string" }
            }
          },
          "maxItems": 5
        },
        "visual_references": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 5
        },
        "anti_references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sites/styles we must not resemble"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "sections": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "proof": { "type": "string" }
        }
      }
    },
    "contact": {
      "type": "object",
      "required": ["email", "phone"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "hours": { "type": "string" },
        "maps_url": { "type": "string", "format": "uri" },
        "cta_label": { "type": "string" },
        "response_time_promise": {
          "type": "string",
          "description": "e.g. Wir melden uns innerhalb eines Werktags."
        }
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "logo": { "type": "string" },
        "og_image": {
          "type": "string",
          "description": "Path or URL to 1200x630 social share image"
        },
        "team_photo": {
          "type": "string",
          "description": "Real team/work photo path; omit if none"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "alt"],
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string", "minLength": 3 }
            }
          }
        },
        "missing": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Assets still needed before content.lock"
        }
      }
    },
    "launch": {
      "type": "object",
      "description": "20-point pre-launch intake (see templates/client-brief/INTAKE-QUESTIONS.md)",
      "properties": {
        "custom_404": { "type": "boolean", "default": true },
        "cta_above_fold": { "type": "boolean", "default": true },
        "internal_links": { "type": "boolean", "default": true },
        "thank_you_page": { "type": "boolean", "default": true },
        "breadcrumbs": { "type": "boolean", "default": true },
        "case_studies": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "count_available": { "type": "integer", "minimum": 0 }
          }
        },
        "faq_required": { "type": "boolean", "default": true },
        "faq_min_items": { "type": "integer", "minimum": 5, "default": 5 },
        "sticky_mobile_cta": { "type": "boolean", "default": true },
        "robots_txt": { "type": "boolean", "default": true },
        "unique_titles": { "type": "boolean", "default": true },
        "meta_descriptions": { "type": "boolean", "default": true },
        "social_share_image": { "type": "boolean", "default": true },
        "maps_directions": { "type": "boolean", "default": true },
        "reviews": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "source": { "type": "string" },
            "permission_confirmed": { "type": "boolean" }
          }
        },
        "alt_text_policy": {
          "type": "string",
          "enum": ["required", "decorative_ok"]
        },
        "local_schema": { "type": "boolean", "default": true },
        "schema_type": {
          "type": "string",
          "enum": ["LocalBusiness", "ProfessionalService", "Store", "Restaurant", "MedicalBusiness"]
        },
        "privacy_page": { "type": "boolean", "default": true },
        "analytics": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": {
              "type": "string",
              "enum": ["none", "plausible", "google", "matomo"]
            },
            "measurement_id": { "type": "string" },
            "consent_required": { "type": "boolean", "default": true }
          }
        },
        "team_photo": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "path": { "type": "string" },
            "skip_reason": { "type": "string" }
          }
        }
      }
    },
    "legal": {
      "type": "object",
      "required": ["impressum_ready", "privacy_ready"],
      "properties": {
        "impressum_ready": { "type": "boolean" },
        "privacy_ready": { "type": "boolean" },
        "owner": { "type": "string" },
        "vat_id": { "type": "string", "description": "USt-IdNr. (DE…), not tax number" },
        "registry": { "type": "string", "description": "e.g. Amtsgericht … HRB …" },
        "legal_form": { "type": "string" },
        "supervisory_authority": {
          "type": "string",
          "description": "Required for licensed trades (GastG, §34c GewO, …)"
        },
        "vsbg_employee_count_over_10": { "type": "boolean" },
        "vsbg_willing_to_participate": { "type": "boolean" },
        "vsbg_statement": { "type": "string" },
        "odr_link_removed": {
          "type": "boolean",
          "description": "Must be true — EU ODR/OS platform retired 2025-07-20"
        },
        "bfsg_in_scope": {
          "type": "boolean",
          "description": "Accessibility Act likely applies (e-commerce / online contract)"
        },
        "bfsg_micro_enterprise_exemption": { "type": "boolean" },
        "accessibility_statement_url": { "type": "string" },
        "client_approved_texts": {
          "type": "boolean",
          "description": "Client/lawyer approved final Impressum + Privacy copy"
        },
        "disclaimer": {
          "type": "string",
          "default": "Factory drafts are not legal advice."
        }
      }
    },
    "regulated_profession": {
      "type": "object",
      "description": "§ 5 Abs. 1 Nr. 5 DDG + chamber rules (doctors, lawyers, health crafts, …)",
      "properties": {
        "enabled": { "type": "boolean" },
        "profession_title": { "type": "string" },
        "awarding_state": { "type": "string", "default": "Deutschland" },
        "chamber_name": { "type": "string" },
        "chamber_address": { "type": "string" },
        "chamber_url": { "type": "string" },
        "professional_rules_label": { "type": "string" },
        "professional_rules_url": { "type": "string" },
        "kv_name": { "type": "string", "description": "Kassenärztliche Vereinigung if applicable" },
        "kv_url": { "type": "string" },
        "hwg_review_required": {
          "type": "boolean",
          "description": "Heilmittelwerbegesetz review for medical marketing copy"
        }
      }
    },
    "hosting": {
      "type": "object",
      "properties": {
        "staging_subdomain": { "type": "string" },
        "production_domain": { "type": "string" },
        "need_forms": { "type": "boolean", "default": true },
        "need_cms": { "type": "boolean", "default": false },
        "form_endpoint": {
          "type": "string",
          "description": "POST target for contact form (Formspree/own API). If omitted, demo GET /danke."
        },
        "site_url": {
          "type": "string",
          "description": "Canonical production URL for OG + schema"
        }
      }
    },
    "locks": {
      "type": "object",
      "properties": {
        "design_locked_at": { "type": ["string", "null"], "format": "date-time" },
        "content_locked_at": { "type": ["string", "null"], "format": "date-time" },
        "launch_checked_at": { "type": ["string", "null"], "format": "date-time" },
        "approved_by": { "type": ["string", "null"] }
      }
    }
  },
  "additionalProperties": false
}
