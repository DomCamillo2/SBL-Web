{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbl-web.local/schemas/content.schema.json",
  "title": "KMU Website Content Pack",
  "type": "object",
  "required": ["slug", "locale", "pages", "seo_defaults"],
  "properties": {
    "slug": { "type": "string" },
    "locale": { "type": "string", "default": "de-DE" },
    "draft": {
      "type": "boolean",
      "description": "true while factory draft is unreviewed"
    },
    "brand_voice_notes": { "type": "string" },
    "forbidden_phrases": {
      "type": "array",
      "items": { "type": "string" },
      "default": [
        "Unlock the power",
        "Seamless",
        "Cutting-edge",
        "Next-level",
        "Revolutionize",
        "Ganzheitliche Lösungen",
        "Mit Leidenschaft und Innovation"
      ]
    },
    "seo_defaults": {
      "type": "object",
      "required": ["site_name", "title_suffix"],
      "properties": {
        "site_name": { "type": "string" },
        "title_suffix": { "type": "string" },
        "default_description": { "type": "string", "maxLength": 160 }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "title", "meta_description", "sections"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "title": { "type": "string" },
          "meta_description": { "type": "string", "maxLength": 160 },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "job", "headline"],
              "properties": {
                "id": { "type": "string" },
                "job": {
                  "type": "string",
                  "description": "One purpose for this section"
                },
                "eyebrow": { "type": "string" },
                "headline": { "type": "string" },
                "support": { "type": "string" },
                "cta_label": { "type": "string" },
                "cta_href": { "type": "string" },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": { "type": "string" },
                      "body": { "type": "string" },
                      "meta": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
