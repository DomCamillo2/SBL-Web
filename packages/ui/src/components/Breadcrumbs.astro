---
const { items = [] } = Astro.props;
---
{items.length > 0 && (
  <nav class="sbl-breadcrumbs" aria-label="Brotkrumen">
    <ol>
      {items.map((item, i) => (
        <li>
          {i < items.length - 1 && item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .sbl-breadcrumbs {
    font-size: 0.85rem;
    color: var(--sbl-muted, #4a5a62);
    margin: 0 0 1.25rem;
  }
  .sbl-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sbl-breadcrumbs li:not(:last-child)::after {
    content: "/";
    margin-left: 0.5rem;
    opacity: 0.5;
  }
  .sbl-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }
  .sbl-breadcrumbs a:hover {
    color: var(--sbl-fg, #132028);
  }
</style>
